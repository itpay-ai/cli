  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/qrcode": "^1.5.5",
    "c8": "^10.1.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76",
    "esbuild": "0.28.1"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build-buyer.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/src/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "check": "npm run lint && npm run test:coverage && npm run test:package",
    "pack:dry-run": "npm run clean && npm run build && npm pack --dry-run --ignore-scripts",
    "test:package": "npm run build && node scripts/check-buyer-package.mjs && node scripts/package-smoke.mjs",
    "prepack": "npm run build && node scripts/check-buyer-package.mjs",
    "prepublishOnly": "npm run check",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "c8 --all --src src --extension .ts --exclude=src/client/types.ts --exclude=tests/** --exclude=scripts/** --reporter=text --reporter=lcov --check-coverage --lines 85 --statements 85 --functions 90 --branches 70 npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:seller:package": "node scripts/fetch-sell-runtime.mjs && node scripts/check-sell-package.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itpay-ai/cli.git"
  },
  "itpayBundleFormat": "buyer-esm-v1"
}
